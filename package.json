{
  "name": "wcygan-net",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@tanstack/react-router-devtools": "^1.166.13",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "1.3.10",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "^29.0.2",
    "lefthook": "^2.1.5",
    "nitro": "^3.0.260429-beta",
    "portless": "^0.12.0",
    "prettier": "3.8.3",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "7.2.7",
    "vitest": "^4.1.4",
    "wrangler": "^4.90.0"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@shikijs/rehype": "^4.0.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-router": "1.168.18",
    "@tanstack/react-start": "1.167.32",
    "autoprefixer": "^10.4.27",
    "leaflet": "^1.9.4",
    "mermaid": "^11.14.0",
    "postcss": "^8.5.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "^4.0.2",
    "shiki-transformer-copy-button": "^0.0.6",
    "tailwindcss": "^3",
    "three": "^0.186.0"
  },
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "PORTLESS_STATE_DIR=$HOME/.portless PORTLESS_PORT=443 PORTLESS_HTTPS=1 scripts/ensure-portless-proxy.sh && PORTLESS_STATE_DIR=$HOME/.portless PORTLESS_PORT=443 PORTLESS_HTTPS=1 bun --bun run portless run bun run dev-vite",
    "dev-vite": "bun --bun run vite dev",
    "build": "bun run generate:embedding-land && bun scripts/build.mjs",
    "generate:embedding-land": "bun scripts/generate-embedding-land.mjs",
    "preview": "bun --bun run vite preview",
    "preview-static": "bun scripts/preview-static.ts",
    "benchmark:3d": "bun scripts/benchmark-3d-demos.ts",
    "render:diagrams": "bun scripts/render-diagrams.mjs",
    "deploy": "bun run build && bun --bun run wrangler deploy",
    "test": "bun --bun run vitest run",
    "fmt": "bun --bun run prettier --write .",
    "typecheck": "bun --bun run tsc --noEmit",
    "pre-commit": "bun run fmt && bun run typecheck && bun run test"
  },
  "trustedDependencies": [
    "esbuild",
    "lefthook"
  ]
}
